64ed8f765cdd","crc32":"02855735","sha1":"0d48c1350037bf3caff8d1cf39207455aafa8a65","length":"2254.67","height":"0","width":"0"},{"name":"Cicadas_Northeast_Indiana_USA_2011-08-18.png","source":"derivative","format":"PNG","original":"Cicadas_Northeast_Indiana_USA_2011-08-18.flac","mtime":"1417846045","size":"11205","md5":"60cfc5059e43392f8b481a4fe2f11e87","crc32":"6f678d2a","sha1":"955608c99191aba11abc201469b6a05e5201eb76"},{"name":"Cicadas_Northeast_Indiana_USA_2011-08-18.wav","source":"original","format":"WAVE","length":"2254.67","mtime":"1313769077","size":"397724630","md5":"9eb90773beed62633c7907101f2f6392","crc32":"7295b2c3","sha1":"344341f14634e1e899fd2312d6ed147b2a96df85","title":"Cicadas","creator":"John Radawski","album":"Northeast Indiana USA 2011-08-18","track":"01","height":"0","width":"0"},{"name":"Cicadas_Northeast_Indiana_USA_2011-08-18_archive.torrent","source":"metadata","btih":"64add9bdcce01ff76703ecafa5321cf515e171c2","mtime":"1613271170","size":"31869","md5":"10bd9e8005d7d80e8dc463e162246d4d","crc32":"6a12f39c","sha1":"dee000f1539f492e69718922e30c23c50af7d556","format":"Archive BitTorrent"},{"name":"Cicadas_Northeast_Indiana_USA_2011-08-18_files.xml","source":"metadata","format":"Metadata","md5":"6b0c142eb0a45b4e9a217465dd2ca6c9","summation":"md5"},{"name":"Cicadas_Northeast_Indiana_USA_2011-08-18_meta.xml","source":"metadata","format":"Metadata","mtime":"1613271164","size":"3232","md5":"af2ba3d6bfe852ddbd81e0b6e8e6c2b7","crc32":"95b16eea","sha1":"c200df3e0612e13d5318f308d2a26c2b6ec079f8"},{"name":"Cicadas_Northeast_Indiana_USA_2011-08-18_spectrogram.png","source":"derivative","format":"Spectrogram","original":"Cicadas_Northeast_Indiana_USA_2011-08-18.wav","mtime":"1417845946","size":"261212","md5":"cb2e16c3d83abc21f7ef8b029c5a78a0","crc32":"83efb5ae","sha1":"a047296b131703ee59c9bf318686e94f141e8591"},{"name":"__ia_thumb.jpg","source":"original","mtime":"1613271164","size":"3245","md5":"0288cf8a19216223e58123467895fa4a","crc32":"14723834","sha1":"6eaf1104b6524e39ef501040ce7bf27016f63e60","format":"Item Tile","rotation":"0"}],"files_count":12,"item_last_updated":1785106462,"item_size":750226538,"metadata":{"identifier":"Cicadas_Northeast_Indiana_USA_2011-08-18","title":"Cicadas_Northeast_Indiana_USA_2011-08-18","creator":"John Radawski","mediatype":"audio","collection":["opensource_audio","community"],"description":"This is a field recording of North American cicadas. It was recorded between 8 and 9 pm (EST) on August 18th of 2011 near Fort Wayne, Indiana. This file was created with a Zoom H4n. The file has been compressed and equalized and some traffic noise has been edited out. It runs about 38 minutes. Caution. This file gets loud! They are cicadas after all.","date":"2011-08-18","year":"2011","subject":"cicadas; summer sounds; ambient sound; zoom H4n; radawski","licenseurl":"http://creativecommons.org/publicdomain/zero/1.0/","publicdate":"2011-08-19 15:52:23","addeddate":"2011-08-19 15:40:52","uploader":"REDACTED@example.org","updater":["John Radawski","John Radawski","John Radawski","John Radawski"],"updatedate":["2011-08-19 15:55:57","2011-08-19 16:14:45","2011-08-19 18:36:54","2011-08-19 18:37:48"],"taper":"John Radawski","source":"Zoom H4n","runtime":"38 min.","notes":"There were a couple of interesting things I noticed upon looking at the waveform for this file. To the human ear, cicada songs sound quite random, but the waveform tells a different story. \n\nFirst, the crescendos are amazingly smooth. I've never seen a natural waveform quite like this one. The base shape of the cicadas' song is an amazingly smooth wave. Such smooth shapes are very rare outside of, say, electronic music. Also, in terms of volume, successive crescendos can be exactly the same volume for many minutes while being punctuated by much louder crescendos. The cicadas are able to maintain an amazing control over volume output for long periods of time. Again, this is a level of order I did not expect to see.\n\nSecond, the left and right channels are extremely different. It's almost as if you can pick out different groups of cicadas on either side of the recorder saying different things. Often it follows a pattern which could be described as \"left side sing, right side sing, all sing.\" The only other form of audio I can think of which relies heavily on subtle differences in left versus right channel is those meditation tapes which are supposed to activate each side of your brain, or again, electronic music.\n\nThe last point makes me wonder if the point of cicada songs is to lure predators into some sort of hypnagogic or trance-like state where they are less prone to feeding. Clearly there is a high degree of order to cicada songs, but I leave it up to science to determine what these little beasts are saying! \n\nOpen source audio. Enjoy!","curation":"[curator]REDACTED@example.org[/curator][date]20140328092111[/date][comment]checked for malware[/comment]","backup_location":"ia903702_21"},"server":"dn601304.us.archive.org","simplelists":{"solo_manifest":{"solo_manifest_dn601304":{"sys_changed_by":{"source":"task","task_id":"5524649143"},"sys_last_changed":"2026-07-26 22:54:31.830678"}}},"solo":true,"uniq":127841093,"workable_servers":["dn601304.us.archive.org"]}